  "theme": {
    "dark": {
      "color": {
        "surface": {
          "page": { "$type": "color", "$value": "{color.dark.page}" },
          "local": { "$type": "color", "$value": "{color.dark.panel}" },
          "raised": { "$type": "color", "$value": "{color.dark.raised}" },
          "hover": { "$type": "color", "$value": "{color.dark.hover}" }
        },
        "text": {
          "primary": { "$type": "color", "$value": "{color.dark.text}" },
          "secondary": { "$type": "color", "$value": "{color.dark.soft}" },
          "muted": { "$type": "color", "$value": "{color.dark.muted}" },
          "quiet": { "$type": "color", "$value": "{color.dark.quiet}" },
          "danger": { "$type": "color", "$value": "{color.shared.dangerDark}" },
          "success": { "$type": "color", "$value": "{color.shared.successDark}" },
          "permission": { "$type": "color", "$value": "{color.shared.permissionDark}" },
          "warning": { "$type": "color", "$value": "{color.shared.permissionDark}" },
          "info": { "$type": "color", "$value": "{color.shared.linkDark}" },
          "link": { "$type": "color", "$value": "{color.shared.linkDark}" },
          "linkVisited": { "$type": "color", "$value": "{color.shared.linkVisitedDark}" }
        },
        "border": {
