    "control": { "$type": "dimension", "$value": "{space.100}" },
    "row": { "$type": "dimension", "$value": "{space.150}" },
    "gutter": { "$type": "dimension", "$value": "{space.200}" },
    "card": { "$type": "dimension", "$value": "{space.300}" },
    "header": { "$type": "dimension", "$value": "{space.400}" },
    "region": { "$type": "dimension", "$value": "{space.400}" },
    "section": { "$type": "dimension", "$value": "{space.600}" },
    "major": { "$type": "dimension", "$value": "{space.800}" }
  },
  "type": {
    "helper": { "$type": "dimension", "$value": "{font.size.helper}" },
    "action": { "$type": "dimension", "$value": "{font.size.action}" },
    "row": { "$type": "dimension", "$value": "{font.size.row}" },
    "body": { "$type": "dimension", "$value": "{font.size.body}" },
    "conversation": { "$type": "dimension", "$value": "{font.size.conversation}" }
