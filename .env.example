# DeepSeek — auto-creates endpoint on first boot
DEEPSEEK_API_KEY=sk-...

# Anthropic (Claude) — auto-creates endpoint on first boot
ANTHROPIC_API_KEY=sk-ant-...

# generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# flip to true to enable password login
AUTH_ENABLED=false
AUTH_PASSWORD=changeme

PORT=6769

# device is the safe default. lan also requires AUTH_ENABLED=true and a real password.
ALLES_ACCESS_PROFILE=device
ALLES_HOST=127.0.0.1
# optional exact comma-separated browser origins; wildcard origins are rejected
ALLES_CORS_ORIGINS=
# public mode additionally requires an HTTPS origin, exact trusted hosts, and proxy IPs/CIDRs
ALLES_PUBLIC_URL=
# public BASE_DOMAIN is the same apex host; *.BASE_DOMAIN serves the app subdomains
BASE_DOMAIN=localhost
ALLES_TRUSTED_HOSTS=
ALLES_FORWARDED_ALLOW_IPS=

# optional data location and release markers recorded in recovery manifests
# ALLES_DATA=/path/to/alles-data
ALLES_VERSION=development
ALLES_BUILD_ID=local
# strict comma-separated allow-list; unfinished Afterlife surfaces default off
ALLES_AFTERLIFE_FEATURES=

# optional — research mode web search (get a free key at tavily.com)
# without this, falls back to DuckDuckGo (limited results)
TAVILY_API_KEY=
